{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook-whatsapp",
      "dest": "/api/webhook-whatsapp.js"
    }
  ],
  "crons": [
    {
      "path": "/api/extraer-gasto",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/sync-ventas",
      "schedule": "30 12 * * *"
    }
  ]
}
